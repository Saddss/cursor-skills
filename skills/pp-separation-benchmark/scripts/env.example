# Copy to my.env, edit, then:  set -a && . ./my.env && set +a
# These values fill the @@VAR@@ placeholders in ../manifests/*.yaml.

# vLLM serving image (must be glibc-based; see pitfalls.md #4).
VLLM_IMAGE="your-registry/vllm:tag"

# Host directory holding the model weights. Mounted into the kind node via
# kind-config extraMounts, then hostPath-mounted into pods at the same path.
HF_HOST_PATH="/path/on/host/hf"

# Model path AS SEEN INSIDE THE CONTAINER (i.e. under the mounted weights dir).
MODEL_PATH="/root/.cache/huggingface/YourModel"

# Served model name advertised on /v1/models (client --model must match).
SERVED_MODEL="org/YourModel"

# MTP/speculative draft model path inside the container. If you don't use
# speculative decoding, set to "" AND remove the --speculative-config line from
# the manifests before rendering.
DRAFT_PATH="/root/.cache/huggingface/YourDraftModel/snapshots/<hash>"

# ---- kind GPU passthrough (used by setup-kind-gpu.sh, not render) ----
# Cluster name (default pp-split). NODE derives as ${CLUSTER}-control-plane.
CLUSTER="pp-split"
# OPTIONAL shared-host GPU allowlist (comma-separated UUIDs). Leave empty on a
# dedicated host to use all GPUs. On a shared host, list only the cards you own:
#   nvidia-smi --query-gpu=index,uuid --format=csv,noheader
GPU_ALLOWLIST=""
